# Game files: everyone brings their own copy. Never commit them.
*.apk
*.xapk
*.obb
extracted/
ripped/

# Generated by tools/setup.py and the other tools
build/
game/
tools/AssetRipper/
tools/realesrgan/
tools/*.log
__pycache__/

# Unity
BountyHunterPC/[Ll]ibrary/
BountyHunterPC/[Tt]emp/
BountyHunterPC/[Oo]bj/
BountyHunterPC/[Ll]ogs/
BountyHunterPC/[Uu]ser[Ss]ettings/
BountyHunterPC/*.csproj
BountyHunterPC/*.sln
BountyHunterPC/*.slnx
BountyHunterPC/.vs/
BountyHunterPC/.vscode/

# Assets come from the game export, except our own code and shaders.
# Assets/Scripts and Assets/Plugins (decompiled game code) are rebuilt from patches/.
BountyHunterPC/Assets/*
!BountyHunterPC/Assets/PCPort/
!BountyHunterPC/Assets/PCPort.meta
!BountyHunterPC/Assets/Shader/
!BountyHunterPC/Assets/Shader.meta
# generated by the dev build (PcPortGallery), points to assets of your own export
BountyHunterPC/Assets/PCPort/Scenes/
BountyHunterPC/Assets/PCPort/Scenes.meta
